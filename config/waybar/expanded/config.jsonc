{
    "layer": "top",
    "position": "top",
    "height": 38,
    "exclusive": false,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,
    "modules-left": [
        "custom/distro",
        "hyprland/window"
    ],
    "modules-center": [
        "custom/term",
        "custom/nightlight",
        "custom/files",
        "custom/browser",
        "custom/media"
    ],
    "modules-right": [
        "custom/home",
        "custom/dnd",
        "tray",
        "memory",
        "battery",
        "clock",
        "custom/collapse",
        "custom/power"
    ],
    "custom/distro": {
        "format": "󰈸",
        "tooltip": "hyprdesk system",
        "on-click": "pkill -x rofi || rofi -show drun"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 22,
        "rewrite": {
            "": "Desktop",
            "^$": "Desktop",
            "\\((.*)\\) Discord \\| (.*)": "Discord: $2",
            "(.*) — Mozilla Firefox": "Firefox: $1",
            "(.*) - Google Chrome": "Chrome: $1"
        },
        "separate-outputs": true
    },
    "custom/term": {
        "format": "",
        "tooltip": "Launch Kitty Terminal",
        "on-click": "kitty &"
    },
    "custom/nightlight": {
        "format": "",
        "tooltip": "Toggle Night Light",
        "on-click": "noctalia msg nightlight-force-toggle"
    },
    "custom/files": {
        "format": "",
        "tooltip": "Launch File Manager",
        "on-click": "dolphin &"
    },
    "custom/browser": {
        "format": "",
        "tooltip": "Launch Web Browser",
        "on-click": "firefox &"
    },
    "custom/media": {
        "format": "",
        "tooltip": "Media Play / Pause",
        "on-click": "playerctl play-pause"
    },
    "custom/home": {
        "format": "",
        "tooltip": "Control Center Dashboard",
        "on-click": "/home/bihhlal/Projects/Personal/hyprdesk/scripts/toggle-dashboard.sh home"
    },
    "custom/dnd": {
        "format": "󰂚",
        "tooltip": "Toggle Notifications / DND",
        "on-click": "noctalia msg notification-dnd-toggle"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },
    "memory": {
        "format": "󰘚 {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)\nClick to open btop",
        "on-click": "kitty -e btop &",
        "interval": 2
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{capacity}% ({time})",
        "on-click": "/home/bihhlal/Projects/Personal/hyprdesk/scripts/toggle-dashboard.sh power"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "/home/bihhlal/Projects/Personal/hyprdesk/scripts/waybar-controller.sh toggle-mode"
    },
    "custom/collapse": {
        "format": "󰁓",
        "tooltip": "Collapse to Dynamic Island",
        "on-click": "/home/bihhlal/Projects/Personal/hyprdesk/scripts/waybar-controller.sh toggle-mode"
    },
    "custom/power": {
        "format": "",
        "tooltip": "Session / Power Menu",
        "on-click": "noctalia msg panel-toggle session"
    }
}
